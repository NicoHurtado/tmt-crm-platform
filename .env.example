# =============================================================================
# Transportes Medellín Travel — Environment variables (template)
# Copy to .env.local and fill in your values. Never commit real secrets.
# =============================================================================

# --- Database (Railway PostgreSQL en producción, Neon u otro permitido) -----
DATABASE_URL="postgresql://user:password@host:port/database"

# --- NextAuth (admin login) ------------------------------------------------
NEXTAUTH_SECRET="generar-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_PASSWORD="cambiar-en-produccion"

# --- Public app URL --------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Bold (pasarela de pago) -----------------------------------------------
# BOLD_MODE: "test" | "production"
BOLD_MODE="test"
BOLD_SECRET_KEY="prod-secret-key"
BOLD_SECRET_KEY_TEST="test-secret-key"
NEXT_PUBLIC_BOLD_PUBLIC_KEY_TEST="test-public-key"
BOLD_PUBLIC_KEY_TEST="test-public-key"

# --- Cloudinary (imágenes) -------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="your-key"
CLOUDINARY_API_SECRET="your-secret"

# --- Email (Nodemailer vía Gmail SMTP) -------------------------------------
GMAIL_USER="correo@gmail.com"
GMAIL_APP_PASSWORD="app-password-de-google"

# --- Google Calendar (Service Account) -------------------------------------
GOOGLE_CALENDAR_ID="calendar-id@group.calendar.google.com"
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- n8n (webhooks autenticados) -------------------------------------------
N8N_API_KEY="clave-larga-aleatoria"

# --- Toggles dev / runtime -------------------------------------------------
# Pone "1" para suprimir efectos secundarios durante tests/dev local.
DISABLE_ALIADO_EMAILS=""
DISABLE_CALENDAR_SYNC=""
TEST_EMAIL_SECRET=""
